{
  "name": "allow-copy",
  "description": "Enable copying and text selection on websites that disable these features",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "extension dev --browser=chrome --no-telemetry",
    "start": "extension start --browser=chrome --no-telemetry",
    "build": "npm run build:chrome",
    "build:chrome": "extension build --browser=chrome --no-telemetry",
    "preview": "extension preview --browser=chrome --no-telemetry",
    "clean": "tsx tools/clean.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:chrome && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:chrome",
    "zip": "tsx tools/package-extension.ts"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "extension": "^4.1.28",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
